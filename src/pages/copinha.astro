---
import Layout from "../layouts/Layout.astro";
import Tabela from "../components/copinha/Tabela.vue";
import Regras from "../components/copinha/Regras.vue";
---

<Layout>
  <div class="grid grid-cols-5 gap-4 portrait:grid-cols-1">
    <div class="portrait:order-last portrait:hidden">
    </div>
    <div class="h-full col-span-4">
      <div class="flex w-full gap-4 text-white portrait:pb-[200px]">
        <div class="w-8/12 portrait:w-auto portrait:my-0 portrait:mx-auto portrait:max-w-[85vw]">
          <Tabela client:load />
        </div>
        <div class="w-4/12 portrait:w-auto portrait:my-0 portrait:mx-auto portrait:max-w-[85vw]">
          <Regras client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>